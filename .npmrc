# Enforce consistent npm behavior across environments
# Prevents lock file sync issues between local and CI

# Use legacy peer deps to handle React ecosystem compatibility
legacy-peer-deps=true

# Ensure exact versions in lock file
save-exact=false

# Engine strict mode - fail if node version doesn't match
engine-strict=false

# Prevent npm from modifying lock file during install
# (only applies to npm install, not npm ci)
package-lock=true
