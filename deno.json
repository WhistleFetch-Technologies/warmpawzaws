{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"],
    "strict": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "hono": "npm:hono@^4.0.0",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.958.0",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}

