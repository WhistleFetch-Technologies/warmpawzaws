{
  "name": "warmpawz-lambda-handlers",
  "version": "1.0.0",
  "description": "AWS Lambda handlers for Warmpawz platform",
  "main": "dist/handler.js",
  "scripts": {
    "build:contracts": "npm install --prefix ../../packages/api-contracts --no-audit --no-fund && npm run build --prefix ../../packages/api-contracts",
    "build:mappings": "npm install --include=dev --prefix ../../packages/service-launch-mappings --no-audit --no-fund && npm run build --prefix ../../packages/service-launch-mappings",
    "build": "npm run build:contracts && npm run build:mappings && npm run clean && npm run build:bundle && npm run package",
    "build:ts": "tsc --noEmit",
    "build:skip-ts": "npm run clean && npm run build:bundle && npm run package",
    "build:bundle": "node esbuild.config.js",
    "build:legacy": "npm run clean && tsc && npm run package",
    "package": "powershell -Command \"Compress-Archive -Path dist\\* -DestinationPath api-handler.zip -Force; if (Test-Path 'dist\\loyalty-consumer.js') { Compress-Archive -LiteralPath 'dist\\loyalty-consumer.js' -DestinationPath 'loyalty-consumer.zip' -Force }\"",
    "test": "jest",
    "test:local": "./test-local.sh",
    "test:sentry": "node scripts/test-sentry.js",
    "start:local": "npm run build:contracts && npm run build:bundle && dotenv -e .env.local -- npx serverless offline --config serverless.local.yml",
    "start:local:logs": "powershell -ExecutionPolicy Bypass -File ./start-local-with-logs.ps1",
    "lint": "eslint src --ext .ts",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true}); for (const z of ['api-handler.zip','loyalty-consumer.zip']) if (fs.existsSync(z)) fs.unlinkSync(z)\""
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.975.0",
    "@aws-sdk/client-bedrock-runtime": "^3.971.0",
    "@aws-sdk/client-chime-sdk-meetings": "^3.450.0",
    "@aws-sdk/client-cloudwatch": "^3.966.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.450.0",
    "@aws-sdk/client-eventbridge": "^3.1036.0",
    "@aws-sdk/client-lambda": "^3.993.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/client-secrets-manager": "^3.450.0",
    "@aws-sdk/client-ses": "^3.966.0",
    "@aws-sdk/client-sns": "^3.450.0",
    "@aws-sdk/client-sqs": "^3.450.0",
    "@aws-sdk/client-sts": "^3.450.0",
    "@aws-sdk/client-textract": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@sentry/serverless": "^7.120.4",
    "@warmpawz/api-contracts": "file:../../packages/api-contracts",
    "@warmpawz/shared-types": "file:../../packages/shared-types",
    "@warmpawz/service-launch-mappings": "file:../../packages/service-launch-mappings",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "firebase-admin": "^12.0.0",
    "hono": "^4.6.14",
    "jose": "^5.2.0",
    "pg": "^8.11.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-cloudfront-invalidate": "^1.12.2",
    "serverless-offline": "^14.4.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
