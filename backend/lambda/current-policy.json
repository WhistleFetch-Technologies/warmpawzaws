{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Action":  [
                                         "secretsmanager:GetSecretValue",
                                         "secretsmanager:DescribeSecret"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:secretsmanager:ap-south-1:057442119249:secret:warmpawz-prod-rds-master-20260207201049162400000001-hmqkCE",
                                           "arn:aws:secretsmanager:ap-south-1:057442119249:secret:warmpawz/prod/razorpay-bNyvFV",
                                           "arn:aws:secretsmanager:ap-south-1:057442119249:secret:warmpawz/prod/google-maps-muuCHl",
                                           "arn:aws:secretsmanager:ap-south-1:057442119249:secret:warmpawz/prod/shiprocket-q1jLUZ"
                                       ]
                      },
                      {
                          "Action":  [
                                         "s3:GetObject",
                                         "s3:PutObject",
                                         "s3:DeleteObject",
                                         "s3:ListBucket"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:s3:::warmpawz-prod-user-uploads-057442119249/*"
                                       ]
                      },
                      {
                          "Action":  [
                                         "dynamodb:GetItem",
                                         "dynamodb:PutItem",
                                         "dynamodb:UpdateItem",
                                         "dynamodb:DeleteItem",
                                         "dynamodb:Query",
                                         "dynamodb:Scan"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:dynamodb:ap-south-1:057442119249:table/warmpawz-prod-sessions",
                                           "arn:aws:dynamodb:ap-south-1:057442119249:table/warmpawz-prod-cache",
                                           "arn:aws:dynamodb:ap-south-1:057442119249:table/warmpawz-prod-analytics-events"
                                       ]
                      },
                      {
                          "Action":  [
                                         "sns:Publish"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:sns:ap-south-1:057442119249:warmpawz-prod-user-notifications",
                                           "arn:aws:sns:ap-south-1:057442119249:warmpawz-prod-booking-updates",
                                           "arn:aws:sns:ap-south-1:057442119249:warmpawz-prod-payment-events"
                                       ]
                      },
                      {
                          "Action":  [
                                         "sqs:SendMessage",
                                         "sqs:ReceiveMessage",
                                         "sqs:DeleteMessage",
                                         "sqs:GetQueueAttributes"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:sqs:ap-south-1:057442119249:warmpawz-prod-booking-processing",
                                           "arn:aws:sqs:ap-south-1:057442119249:warmpawz-prod-payment-processing",
                                           "arn:aws:sqs:ap-south-1:057442119249:warmpawz-prod-notification-delivery",
                                           "arn:aws:sqs:ap-south-1:*:warmpawz-prod-*"
                                       ]
                      },
                      {
                          "Action":  [
                                         "cognito-idp:AdminGetUser",
                                         "cognito-idp:AdminUpdateUserAttributes",
                                         "cognito-idp:ListUsers"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "*"
                                       ]
                      },
                      {
                          "Action":  [
                                         "bedrock:InvokeModel",
                                         "bedrock:InvokeModelWithResponseStream"
                                     ],
                          "Condition":  {
                                            "StringEquals":  {
                                                                 "aws:RequestedRegion":  "ap-south-1"
                                                             }
                                        },
                          "Effect":  "Allow",
                          "Resource":  "*"
                      },
                      {
                          "Action":  [
                                         "es:ESHttpPost",
                                         "es:ESHttpPut",
                                         "es:ESHttpGet",
                                         "es:ESHttpDelete"
                                     ],
                          "Effect":  "Allow",
                          "Resource":  [
                                           "arn:aws:es:ap-south-1:057442119249:domain/warmpawz-prod"
                                       ]
                      }
                  ]
}
