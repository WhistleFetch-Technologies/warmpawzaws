{
  "name": "warmpawz-tests",
  "version": "1.0.0",
  "description": "Test suite for Warmpawz infrastructure",
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:smoke",
    "test:unit": "jest tests/unit --coverage --verbose",
    "test:integration": "jest tests/integration --runInBand --verbose",
    "test:e2e": "jest tests/e2e --runInBand --verbose --testTimeout=60000",
    "test:e2e:full": "jest tests/e2e --runInBand --verbose --testTimeout=120000 --coverage",
    "test:smoke": "jest tests/smoke --verbose --testTimeout=10000",
    "test:smoke:prod": "ENVIRONMENT=prod jest tests/smoke --verbose",
    "test:payment:razorpay": "jest tests/integration/razorpay.test.ts",
    "test:payment:stripe": "jest tests/integration/stripe.test.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "type-check": "tsc --noEmit",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd apps/customer-web && npm run build && cd ../vendor-web && npm run build && cd ../admin-web && npm run build",
    "package:lambda": "cd backend/lambda && ./package.sh",
    "validate:secrets": "node scripts/validate-secrets.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "backend/**/*.ts",
      "!backend/**/*.test.ts",
      "!backend/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/jest.setup.ts"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-apigateway": "^3.450.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.450.0",
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-rds": "^3.450.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/client-secretsmanager": "^3.450.0",
    "@aws-sdk/client-sns": "^3.450.0",
    "@aws-sdk/client-sqs": "^3.450.0",
    "@aws-sdk/client-ssm": "^3.450.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "pg": "^8.11.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2"
  }
}

