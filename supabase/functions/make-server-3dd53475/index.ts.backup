// ✅ DISABLED: Role Service initialization to prevent KV store timeout on cold starts
// The system has 84+ custom roles which causes getByPrefix to timeout
// Roles are now cached in-memory and loaded on-demand by role-service.tsx
// import { initializeRoleService } from "./role-service.tsx";
// initializeRoleService().catch(err => console.error('❌ Role service initialization failed:', err));

// ✅ ROOT CAUSE FIX: Use Hono's CORS middleware properly
// Hono's CORS middleware handles OPTIONS automatically when configured correctly

// ✅ MINIMAL SAFETY WRAPPER: Catches ALL requests before Hono app
// This ensures OPTIONS and health always work even if app fails
console.info('[make-server] starting');

function corsHeaders(): Record<string, string> {
  return {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,PUT,PATCH,DELETE,OPTIONS',
    'Access-Control-Allow-Headers': 'authorization,content-type,Content-Type,Authorization,X-Requested-With,Accept,Cache-Control,Pragma',
    'Access-Control-Max-Age': '86400',
    'Connection': 'keep-alive'
  };
}

function isHealth(pathname: string): boolean {
  if (pathname === '/health' || pathname === '/make-server/health') return true;
  return /^\/make-server-[A-Za-z0-9-]+\/health$/.test(pathname) || pathname.endsWith('/health');
}

// ✅ TOP-LEVEL ERROR HANDLING: Wrap Deno.serve with minimal safety checks
try {
  Deno.serve(async (req: Request) => {
    try {
      const { pathname } = new URL(req.url);
      
      // ✅ CRITICAL: Global preflight guard FIRST - before any app logic
      if (req.method === 'OPTIONS') {
        return new Response(null, { status: 204, headers: corsHeaders() });
      }
      
      // ✅ Health must be public and simple - handle before Hono app
      if (isHealth(pathname)) {
        return new Response(
          JSON.stringify({ ok: true, status: 'ok', timestamp: new Date().toISOString(), path: pathname }),
          { 
            status: 200, 
            headers: { 
              'Content-Type': 'application/json',
              ...corsHeaders()
            } 
          }
        );
      }
      
      // ✅ Now try Hono app for all other requests
      try {
        return await app.fetch(req);
      } catch (appError) {
        console.error('❌ [HONO-APP] Error:', appError);
        // Ensure error response has CORS headers
        return new Response(
          JSON.stringify({ 
            error: 'Internal Server Error',
            message: appError instanceof Error ? appError.message : String(appError)
          }),
          { 
            status: 500,
            headers: { 
              'Content-Type': 'application/json',
              ...corsHeaders()
            }
          }
        );
      }
      
    } catch (error) {
      console.error('❌ [TOP-LEVEL] Unhandled request error:', error);
      return new Response(
        JSON.stringify({ 
          error: 'Internal Server Error',
          message: error instanceof Error ? error.message : String(error)
        }),
        { 
          status: 500,
          headers: { 
            'Content-Type': 'application/json',
            ...corsHeaders()
          }
        }
      );
    }
  });
} catch (error) {
  console.error('❌ [FATAL] Server initialization failed:', error);
  // Exit with error code so Supabase can detect the failure
  Deno.exit(1);
}

// ✅ Background init guarded to avoid ReferenceError
(async () => {
  try {
    // @ts-ignore - check existence safely
    if (typeof EdgeRuntime !== 'undefined' && EdgeRuntime?.waitUntil) {
      // @ts-ignore
      EdgeRuntime.waitUntil(Promise.resolve());
    }
  } catch {
    /* no-op */
  }
})();