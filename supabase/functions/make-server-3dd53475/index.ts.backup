const app = new Hono();

// Global Middleware
// ✅ CORS: Configure CORS middleware FIRST - handles OPTIONS automatically
// This MUST be registered before any routes
app.use('*', cors({
  origin: '*',
  allowMethods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS', 'PATCH'],
  allowHeaders: ['Content-Type', 'Authorization', 'X-Requested-With', 'Accept', 'Cache-Control', 'Pragma'],
  exposeHeaders: ['Content-Length', 'Content-Type'],
  maxAge: 86400,
  credentials: false,
}));
app.use('*', logger(console.log));

// ✅ CRITICAL FIX: Global OPTIONS handler - MUST be before any route registration
// This handles ALL OPTIONS requests (preflight) before they reach route handlers
// Matches both hashed and unhashed function paths
app.options('*', (c) => {
  c.header('Access-Control-Allow-Origin', '*');
  c.header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS, PATCH');
  c.header('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Requested-With, Accept, Cache-Control, Pragma');
  c.header('Access-Control-Max-Age', '86400');
  return c.text('', 204);
});

// ✅ CRITICAL FIX: Public health endpoint - accessible without auth
// Handles both hashed and unhashed paths
app.get('/health', (c) => {
  c.header('Access-Control-Allow-Origin', '*');
  return c.json({ status: 'ok', timestamp: new Date().toISOString() });
});
// Also handle health under the function prefix
app.get('/make-server-3dd53475/health', (c) => {
  c.header('Access-Control-Allow-Origin', '*');
  return c.json({ status: 'ok', timestamp: new Date().toISOString() });
});
// Handle health with regex pattern for any make-server variant
app.get('/make-server*/health', (c) => {
  c.header('Access-Control-Allow-Origin', '*');
  return c.json({ status: 'ok', timestamp: new Date().toISOString() });
});

// ------------------------------------------------------------------
// ✅ SQL: Region endpoints are handled by regionEndpoints() function
// All KV-based region endpoints removed - using SQL repositories
// ------------------------------------------------------------------

// CRITICAL ACTION GUARD
// Protects destructive endpoints from accidental execution
app.use('/make-server-3dd53475/admin/catalog/clear', criticalActionGuard());
app.use('/make-server-3dd53475/admin/catalog/seed', criticalActionGuard());
app.use('/make-server-3dd53475/admin/onboarding-fields/sync', criticalActionGuard());

// ------------------------------------------------------------------
// REGISTER ROUTES
// IMPORTANT: Order matters! Specific routes must be registered before generic wildcards.
// ------------------------------------------------------------------

// 1. Universal Problem Discovery (Specific /customer/ path)
registerUniversalDiscovery(app);
registerUniversalCustomerSearch(app);
registerCustomerBookingHistory(app);
registerCustomerSearchEndpoints(app);
notificationEndpoints(app); // ✅ SQL-only, no kv parameter
reviewEndpoints(app); // ✅ SQL-only, no kv parameter
analyticsEndpoints(app); // ✅ SQL-only, no kv parameter

// ✅ NEW: Advanced Search Engine with Fuse.js
console.log('🔍 Registering Advanced Search Engine...');
enhancedSearchEngineEndpoints(app); // ✅ SQL-only, no kv parameter
searchEndpoints(app); // ✅ SQL-only: Search endpoints (vendors, services, categories)

// 2. Vendor Specific Routes (Dashboard, Onboarding, Config, Services)
// These must be registered BEFORE customer-routes because customer-routes
// contains a generic /vendor/:vendorId wildcard that would shadow these.
vendorOnboardingEndpoints(app); // ✅ SQL-only, no kv parameter
registerVendorProfileUpdateEndpoints(app); // ✅ SQL-only: Vendor profile update with re-approval logic
soloProviderEndpoints(app); // ✅ SQL-only, no kv parameter
vendorApprovalWorkflowEndpoints(app); // ✅ SQL-only, no kv parameter
vendorDashboardEndpoints(app); // ✅ SQL-only, no kv parameter
vendorRoleConfigEndpoints(app);
roleConfigEndpoints(app); // ✅ SQL-only: No kv parameter needed
registerDynamicOnboarding(app);
// ⚠️ TEMPORARILY DISABLED: Using new clean API instead
// enhancedOnboardingManagement(app); // ✅ SQL-only: Enhanced onboarding form builder endpoints
onboardingFormAPI(app); // ✅ NEW: Clean, unified onboarding form API (replaces enhanced-onboarding-management)
onboardingConfigEndpoints(app); // ✅ SQL-only, no kv parameter
app.route('/', restoreEnhancedForms); // ✅ Restore enhanced forms from KV to SQL
restoreOnboardingFields(app); // ✅ Restore missing onboarding fields (Aadhar, Google Maps PIN, Specialization)
registerVendorServiceEndpoints(app);
registerVendorCatalogAPIV2(app);
customServiceEndpoints(app); // ✅ SQL-only: No kv parameter needed
app.route('/make-server-3dd53475', vendorScheduleV2Endpoints);

// ✅ FIX: Register Vet Specialized Services (ambulance, diagnostics, pharmacy, emergency protocols)
vetSpecializedServicesSQL(app); // ✅ SQL-only: Vet specialized services (ambulance, diagnostics, pharmacy, emergency protocols)

// ✅ FIX: Register Staff CRUD Endpoints (create, read, update, delete staff members)
if (staffCrudEndpoints && typeof staffCrudEndpoints === 'object') {
  console.log('✅ Registering Staff CRUD Endpoints (Create, Read, Update, Delete)...');
  app.route('/', staffCrudEndpoints); // Mount without prefix as it already has /make-server-3dd53475
} else {
  console.warn('⚠️ Staff CRUD Endpoints module undefined, skipping');
}

// 3. Admin Routes
