# =============================================================================
# WARMPAWZ ECOSYSTEM .gitignore
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.next/
out/
.vite/
*.tsbuildinfo

# Environment variables (keep .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Excluded projects (embedded / standalone)
clinical-insight-ai/

# =============================================================================
# LOGS - Keep the root clean!
# =============================================================================
*.log
logs/
coordinator.log

# =============================================================================
# ROOT DIRECTORY PROTECTION
# Prevent AI session artifacts from cluttering root
# =============================================================================
# Don't allow markdown files in root (except README.md)
/*.md
!README.md

# Don't allow random scripts in root
/*.sh
/*.js
!package.json
!*.config.js

# Don't allow report files in root
/*.json
!package.json
!package-lock.json
!turbo.json
!tsconfig.json
/*.txt
/*.sql

# =============================================================================
# TEST & COVERAGE
# =============================================================================
coverage/
*.lcov
.nyc_output/
test-reports/
test-results/

# =============================================================================
# SERVERLESS & DEPLOYMENT
# =============================================================================
.serverless/
cdk.out/
.deploy/
*.zip

# =============================================================================
# TERRAFORM
# =============================================================================
.terraform/
.terraform.lock.hcl
terraform.tfstate*
*.tfstate*
infrastructure/terraform-cleanup/.terraform/

# =============================================================================
# MOBILE APP SENSITIVE FILES
# =============================================================================
keystores/
*.keystore
!**/debug.keystore
keystore.properties
*.jks
*.mobileprovision
*.p12
*.cer
*.p8

# =============================================================================
# CACHE & TEMPORARY
# =============================================================================
.cache/
.parcel-cache
.turbo/
tmp/
temp/
*.tgz
*.pack

# =============================================================================
# LEGACY DIRECTORIES - DO NOT RE-ADD
# =============================================================================
Warmpawzecodev/
coming_soon_personal/
archive/
/src/
/lib/

# =============================================================================
# BACKUP FILES
# =============================================================================
*.backup
*.bak

# Admin config export (may contain secrets; do not commit)
scripts/admin-config/export/

# Prod migration run audit (timestamps / cluster names)
scripts/migration-542-prod-runs.log

# Local DB dumps (do not commit)
db-dumps/

# Local/untracked Maven service tree (not in repo; keeps working copy off branch)
services/delivery-service/

# =============================================================================
# SCREENSHOTS & IMAGES IN ROOT
# =============================================================================
/*.png

# =============================================================================
# BACKUP / DUPLICATE DIRECTORIES - DO NOT COMMIT
# =============================================================================
Admin UI/
backend_modified/
complexProblemFix/
copmplexProblmeFix/
wi/
reports/
test-data/
misc/
docs/

# =============================================================================
# BUILD BACKUP DIRECTORIES
# =============================================================================
dist_backup/

# =============================================================================
# RUNTIME ARTIFACTS
# =============================================================================
$null
**/undefined/

# =============================================================================
# CDK COMPILED OUTPUT (keep .ts source, ignore compiled output)
# =============================================================================
infrastructure/cdk/bin/*.js
infrastructure/cdk/bin/*.d.ts
infrastructure/cdk/bin/*.js.map
infrastructure/cdk/bin/*.d.ts.map
infrastructure/cdk/lib/**/*.js
infrastructure/cdk/lib/**/*.d.ts.map
infrastructure/cdk/lib/**/*.js.map
infrastructure/cdk/cdk-outputs.json
infrastructure/cdk/cdk.context.json

# =============================================================================
# TERRAFORM SENSITIVE / GENERATED
# =============================================================================
*.tfvars
tfplan