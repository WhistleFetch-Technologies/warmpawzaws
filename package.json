{
  "name": "warmpawz-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init:native": "./scripts/init-native-projects.sh",
    "install:all": "npm install && cd apps/customer-mobile && npm install && cd ../vendor-mobile && npm install",
    "build:customer:android": "cd apps/customer-mobile && npm run build:apk",
    "build:vendor:android": "cd apps/vendor-mobile && npm run build:apk"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  }
}
