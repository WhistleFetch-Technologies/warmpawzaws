{
  "sample_role_configurations": [
    {
      "id": "role-vet-business-001",
      "name": "veterinarian",
      "display_name": "Veterinarian",
      "description": "Full-service veterinary provider",
      "vendorConfiguration": "business",
      "config": {
        "vendorConfiguration": "business",
        "serviceStyles": ["at_home", "at_center", "tele"],
        "capabilityRules": {},
        "vendorTypes": ["healthcare_provider", "business"]
      },
      "notes": "Business provider with all service styles allowed"
    },
    {
      "id": "role-vet-solo-001",
      "name": "veterinarian",
      "display_name": "Solo Veterinarian",
      "description": "Solo veterinary provider",
      "vendorConfiguration": "solo",
      "config": {
        "vendorConfiguration": "solo",
        "serviceStyles": ["at_home", "tele"],
        "capabilityRules": {
          "solo": {
            "deniedStyles": ["at_center"],
            "deniedCapabilities": ["staff_management", "inventory_manage", "center_profile"],
            "allowCustomServicesForSolo": false
          }
        },
        "vendorTypes": ["healthcare_provider"]
      },
      "notes": "Solo provider restricted to at_home and tele only"
    }
  ],
  "sample_vendor_assignments": [
    {
      "id": "vendor-business-001",
      "vendor_id": "vendor-uuid-001",
      "role_id": "role-vet-business-001",
      "vendor_type": "business",
      "status": "active",
      "notes": "Business vendor with all service styles allowed"
    },
    {
      "id": "vendor-solo-001",
      "vendor_id": "vendor-uuid-002",
      "role_id": "role-vet-solo-001",
      "vendor_type": "solo",
      "status": "active",
      "notes": "Solo vendor restricted to at_home and tele only"
    }
  ],
  "test_scenarios": {
    "allowed_style_creation": {
      "vendor_id": "vendor-business-001",
      "role_id": "role-vet-business-001",
      "allowed_styles": ["at_home", "at_center", "tele"],
      "test_style": "at_center",
      "expected_result": "success",
      "reason": "Business vendor can create services with any allowed style"
    },
    "restricted_style_creation_solo": {
      "vendor_id": "vendor-solo-001",
      "role_id": "role-vet-solo-001",
      "allowed_styles": ["at_home", "tele"],
      "test_style": "at_center",
      "expected_result": "error_403",
      "error_message": "Service style 'at_center' is not allowed for this role. Allowed styles: ['at_home', 'tele']",
      "reason": "Solo vendor cannot create at_center services"
    },
    "allowed_style_creation_solo": {
      "vendor_id": "vendor-solo-001",
      "role_id": "role-vet-solo-001",
      "allowed_styles": ["at_home", "tele"],
      "test_style": "at_home",
      "expected_result": "success",
      "reason": "Solo vendor can create at_home services"
    },
    "role_config_change": {
      "vendor_id": "vendor-business-001",
      "initial_role_id": "role-vet-business-001",
      "updated_role_id": "role-vet-solo-001",
      "initial_allowed_styles": ["at_home", "at_center", "tele"],
      "updated_allowed_styles": ["at_home", "tele"],
      "existing_services": [
        { "id": "service-001", "service_style": "at_center" },
        { "id": "service-002", "service_style": "at_home" }
      ],
      "expected_result": {
        "existing_services_remain": true,
        "new_at_center_blocked": true,
        "new_at_home_allowed": true
      },
      "reason": "Role config change should affect new services but not existing ones"
    },
    "invalid_service_style": {
      "vendor_id": "vendor-business-001",
      "role_id": "role-vet-business-001",
      "allowed_styles": ["at_home", "at_center", "tele"],
      "test_style": "invalid_style",
      "expected_result": "error_400",
      "error_message": "Invalid service style. Valid styles: ['at_home', "at_center", 'tele']",
      "reason": "Invalid service style should be rejected"
    }
  ],
  "validation_rules": {
    "solo_provider_restrictions": {
      "vendorConfiguration": "solo",
      "allowedStyles": ["at_home", "tele"],
      "deniedStyles": ["at_center"],
      "reason": "Solo providers cannot offer at_center services"
    },
    "business_provider_permissions": {
      "vendorConfiguration": "business",
      "allowedStyles": ["at_home", "at_center", "tele"],
      "deniedStyles": [],
      "reason": "Business providers can offer all service styles"
    }
  }
}
