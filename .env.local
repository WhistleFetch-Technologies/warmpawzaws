# Local Development Environment
NODE_ENV=development

# Database (Local PostgreSQL)
AURORA_HOST=localhost
AURORA_PORT=5432
AURORA_DATABASE=warmpawz
AURORA_USER=warmpawz
AURORA_PASSWORD=warmpawz
DATABASE_URL=postgresql://warmpawz:warmpawz@localhost:5432/warmpawz

# S3 (Local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_STORAGE=warmpawz-storage-local
S3_BUCKET_UPLOADS=warmpawz-uploads-local
S3_BUCKET_ASSETS=warmpawz-assets-local
S3_BUCKET_LOGS=warmpawz-logs-local

# Cognito (Use dev/test AWS pools when available)
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID_CUSTOMER=
COGNITO_CLIENT_ID_CUSTOMER=
COGNITO_USER_POOL_ID_VENDOR=
COGNITO_CLIENT_ID_VENDOR=
COGNITO_USER_POOL_ID_ADMIN=
COGNITO_CLIENT_ID_ADMIN=

# API Gateway (Will be set after infrastructure deployment)
API_GATEWAY_URL=

# AWS Region
AWS_REGION=ap-south-1

# AWS Credentials (for testing with real AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
