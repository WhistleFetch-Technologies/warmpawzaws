{
  "name": "warmpawz-lambda-functions",
  "version": "1.0.0",
  "description": "Warmpawz AWS Lambda Functions",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "package": "npm run build && sam package",
    "start:local": "sam local start-api --port 3000",
    "invoke:local": "sam local invoke",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "warmpawz"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.490.0",
    "@aws-sdk/client-rds-data": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-sns": "^3.490.0",
    "@smithy/node-http-handler": "^2.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1",
    "fuse.js": "^7.0.0",
    "hono": "^4.6.14",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
