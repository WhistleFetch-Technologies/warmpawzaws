# ==========================================
# customer-service environment template
# Copy to .env.local (or your runtime env manager)
# ==========================================

# --------------------------
# Core app + DB (example)
# --------------------------
DB_URL=jdbc:postgresql://localhost:5432/warmpawz
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --------------------------
# Security
# For local smoke tests only, you may set false.
# Keep true in shared/prod environments.
# --------------------------
APP_SECURITY_ENABLED=true

# --------------------------
# Cache defaults
# --------------------------
APP_CACHE_READ_TTL_SECONDS=60
APP_CACHE_IDEMPOTENCY_TTL_SECONDS=60
APP_CACHE_READ_MAX_SIZE=1000
APP_CACHE_IDEMPOTENCY_MAX_SIZE=5000

# =====================================================
# LOCAL (safe default): Caffeine only, Redis disabled
# =====================================================
# APP_CACHE_REDIS_ENABLED=false
# APP_CACHE_REDIS_FALLBACK_TO_CAFFEINE_ON_ERROR=true

# =====================================================
# DEV/UAT: Redis enabled with safe fallback
# =====================================================
# APP_CACHE_REDIS_ENABLED=true
# APP_CACHE_REDIS_FALLBACK_TO_CAFFEINE_ON_ERROR=true
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=

# =====================================================
# PROD: Redis enabled with safe fallback
# =====================================================
# APP_CACHE_REDIS_ENABLED=true
# APP_CACHE_REDIS_FALLBACK_TO_CAFFEINE_ON_ERROR=true
# SPRING_DATA_REDIS_HOST=<prod-redis-host>
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=<prod-redis-password>

# --------------------------
# Idempotency provider (existing)
# Keep as currently configured unless changing strategy.
# --------------------------
APP_IDEMPOTENCY_PROVIDER=db
APP_IDEMPOTENCY_TTL_SECONDS=300
