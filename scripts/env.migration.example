# Copy this file to .env.local in this folder (gitignored), then run: npm run migrate:617
#
# One-shot from scripts/ (migrate + build + upload Lambda — uses YOUR credentials, never stores keys in git):
#   .\fix-support-tickets-attachments-full-path.ps1 -Environment dev -DeployLambda
#   .\fix-support-tickets-attachments-full-path.ps1 -Environment both -DeployLambda
# SSO first:
#   .\fix-support-tickets-attachments-full-path.ps1 -Environment dev -AwsProfile <name> -SsoLogin -DeployLambda
# Lambda only (skip RDS):
#   .\fix-support-tickets-attachments-full-path.ps1 -Environment dev -DeployLambda -SkipMigration
#
# Option A — access keys (IAM user or temporary session)
AWS_REGION=ap-south-1
ENVIRONMENT=dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option B — named profile (after `aws configure` or SSO login)
# AWS_PROFILE=default
# AWS_REGION=ap-south-1
# ENVIRONMENT=dev

# Prod cluster: ENVIRONMENT=prod
