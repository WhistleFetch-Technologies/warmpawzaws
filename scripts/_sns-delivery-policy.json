{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnsSmsDeliveryToCloudWatch",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:PutMetricFilter"
      ],
      "Resource": "*"
    }
  ]
}
