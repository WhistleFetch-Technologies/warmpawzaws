# ============================================================================
# WARMPAWZ VENDOR APP - RELEASE KEYSTORE CONFIGURATION
# ============================================================================
# 
# Copy this file to keystore.properties and fill in your values
# DO NOT commit keystore.properties to source control!
#
# To generate a keystore:
# keytool -genkeypair -v -storetype PKCS12 -keystore warmpawz-vendor.keystore \
#   -alias warmpawz-vendor -keyalg RSA -keysize 2048 -validity 10000
#
# ============================================================================

# Absolute path to keystore file (e.g., /path/to/warmpawz-vendor.keystore)
MYAPP_RELEASE_STORE_FILE=

# Keystore password
MYAPP_RELEASE_STORE_PASSWORD=

# Key alias (should match the -alias parameter used when generating)
MYAPP_RELEASE_KEY_ALIAS=warmpawz-vendor

# Key password
MYAPP_RELEASE_KEY_PASSWORD=

