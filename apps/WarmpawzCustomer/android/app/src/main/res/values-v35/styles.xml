<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 35+: same Razorpay checkout bar policy as values/styles.xml (white system status bar,
      dark icons so the orange Razorpay merchant toolbar lays out below the system bar), plus
      mandatory opt-out of default edge-to-edge (Android 15) so the WebView is not drawn under
      the status bar / cutout. Pairs with the runtime fix in
      MainApplication.RazorpayCheckoutWindowInsetsCallback (re-applies WHITE statusBarColor +
      light-status-bar appearance after Razorpay's CheckoutActivity overrides the theme).
    -->
    <style name="AppTheme.RazorpayCheckout" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
