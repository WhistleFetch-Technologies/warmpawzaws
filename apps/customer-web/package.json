{
  "name": "@warmpawz/customer-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "node scripts/free-dev-port.js 3001 && node scripts/clean-next-dev.js && next dev -p 3001",
    "dev:cached": "node scripts/free-dev-port.js 3001 && next dev -p 3001",
    "dev:turbo": "node scripts/free-dev-port.js 3001 && node scripts/clean-next-dev.js && next dev -p 3001 --turbo",
    "dev:turbo:cached": "node scripts/free-dev-port.js 3001 && next dev -p 3001 --turbo",
    "dev:prod": "node scripts/dev-prod.js",
    "build": "next build",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); require('fs').rmSync('dist',{recursive:true,force:true})\" && next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "jest",
    "test:navigation": "jest lib/navigation/__tests__/",
    "test:coverage": "jest --coverage",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:add:ios": "npx cap add ios",
    "cap:verify:push": "bash scripts/cap-push-phase4-verify.sh",
    "cap:checklist:testflight": "bash scripts/cap-testflight-checklist.sh"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^6.3.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@hookform/resolvers": "^3.3.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@warmpawz/service-launch-mappings": "file:../../packages/service-launch-mappings",
    "@warmpawz/shared-types": "file:../../packages/shared-types",
    "@warmpawz/ui": "file:../../packages/ui",
    "amazon-chime-sdk-js": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "firebase": "^12.13.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.487.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.993.0",
    "@aws-sdk/client-s3": "^3.993.0",
    "@capacitor/cli": "^6.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.31",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  }
}
