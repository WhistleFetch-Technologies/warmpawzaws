<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Use for App Store / TestFlight production builds.
  Copy to App.entitlements before Archive, or set in Xcode → Build Settings → CODE_SIGN_ENTITLEMENTS.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:customer.warmpawz.com</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
