# Loaded automatically in `next dev` (not a secret). Skips Next telemetry ping on startup.
NEXT_TELEMETRY_DISABLED=1

# Dev: enable UAT headers + synthetic token path in api-client (must match backend UAT_MODE=true).
NEXT_PUBLIC_UAT_MODE=true

# Shop, cart, wishlist, checkout, and product orders on customer web.
NEXT_PUBLIC_CUSTOMER_ECOMMERCE_ENABLED=true

# Match public/runtime-config.js localhost defaults so SSR and client agree on guest mode.
NEXT_PUBLIC_GUEST_BROWSING_ENABLED=true
NEXT_PUBLIC_GUEST_LOCATION_ENABLED=true
NEXT_PUBLIC_GUEST_BOOKING_ENABLED=false
