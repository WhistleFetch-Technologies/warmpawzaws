# Copy to .env.local for local overrides.
#
# Local Lambda (Serverless Offline) — without this, dev uses config/urls.json API Gateway.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
#
# Never set this in production builds. Mock diagnostic labs (center-1, …) only appear
# in non-production when explicitly enabled (see DiagnosticsServicesLanding).
# NEXT_PUBLIC_SHOW_DIAGNOSTICS_MOCK_LABS=true
#
# Customer shop row on home + cart, wishlist, checkout, orders.
# Set true in .env.local to enable locally; off by default in .env.development.
NEXT_PUBLIC_CUSTOMER_ECOMMERCE_ENABLED=false
#
# New modular customer home UI (phased rollout). Off by default — old UI remains.
# Set true in .env.local to preview the new header, pet strip, and search sections.
# NEXT_PUBLIC_NEW_HOME_UI=true
