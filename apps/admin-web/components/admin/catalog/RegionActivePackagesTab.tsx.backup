'use client';

import { useState, useEffect } from 'react';
import { Search, Plus, Edit, MapPin } from 'lucide-react';
import { Button } from '@warmpawz/ui';
import { apiClient } from '@/lib/api-client';
import { StatusBadge } from './StatusBadge';

interface RegionalPackage {
  id: string;
  name: string;
  region: string;
  status: 'active' | 'inactive' | 'pending';
  price: number;
  services: string[];
  validFrom: string;
  validUntil?: string;
  createdAt: string;
}

export function RegionActivePackagesTab() {
  const [packages, setPackages] = useState<RegionalPackage[]>([]);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState('');
  const [regionFilter, setRegionFilter] = useState<string>('all');

  useEffect(() => {
    loadPackages();
  }, []);

  const loadPackages = async () => {
    try {
      setLoading(true);
      const data = await apiClient.get<any>('/admin/catalog/regional-packages');
      setPackages(data.packages || []);
    } catch (error) {
      console.error('Error loading regional packages:', error);
    } finally {
      setLoading(false);
    }
  };

  const uniqueRegions = Array.from(new Set(packages.map(pkg => pkg.region)));

  const filteredPackages = packages.filter(pkg => {
    if (regionFilter !== 'all' && pkg.region !== regionFilter) return false;
    if (searchQuery && !pkg.name.toLowerCase().includes(searchQuery.toLowerCase())) return false;
    return true;
  });

  if (loading) {
    return <div className="p-6 text-center text-gray-500">Loading regional packages...</div>;
  }

  return (
    <div>
      <div className="flex items-center justify-between mb-4">
        <div className="flex-1 flex gap-3">
          <div className="relative flex-1 max-w-md">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 w-4 h-4" />
            <input
              type="text"
              placeholder="Search packages..."
              value={searchQuery}
              onChange={(e: React.ChangeEvent<HTMLInputElement>) => setSearchQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg text-sm"
            />
          </div>
          <select
            value={regionFilter}
            onChange={(e: React.ChangeEvent<HTMLSelectElement>) => setRegionFilter(e.target.value)}
            className="px-3 py-2 border border-gray-300 rounded-lg text-sm"
          >
            <option value="all">All Regions</option>
            {uniqueRegions.map(region => (
              <option key={region} value={region}>{region}</option>
            ))}
          </select>
        </div>
        <Button className="bg-[#FF8C42] hover:bg-[#FF7A2E]">
          <Plus className="w-4 h-4 mr-2" />
          Add Package
        </Button>
      </div>

      {filteredPackages.length === 0 ? (
        <div className="p-6 text-center text-gray-500">No packages found</div>
      ) : (
        <div className="space-y-3">
          {filteredPackages.map((pkg) => (
            <div key={pkg.id} className="bg-white border rounded-lg p-4 hover:shadow-md transition-shadow">
              <div className="flex items-center justify-between">
                <div className="flex-1">
                  <div className="flex items-center gap-3 mb-2">
                    <MapPin className="w-5 h-5 text-gray-400" />
                    <h4 className="font-semibold text-gray-900">{pkg.name}</h4>
                    <StatusBadge status={pkg.status} />
                    <span className="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded-full">
                      {pkg.region}
                    </span>
                  </div>
                  
                  <div className="flex items-center gap-4 text-sm mb-2">
                    <span className="text-gray-600">
                      Price: <span className="font-semibold text-gray-900">₹{pkg.price}</span>
                    </span>
                    <span className="text-gray-600">
                      Services: <span className="font-semibold text-gray-900">{pkg.services.length}</span>
                    </span>
                    <span className="text-gray-500">
                      Valid from: {new Date(pkg.validFrom).toLocaleDateString()}
                    </span>
                    {pkg.validUntil && (
                      <span className="text-gray-500">
                        Until: {new Date(pkg.validUntil).toLocaleDateString()}
                      </span>
                    )}
                  </div>

                  {pkg.services.length > 0 && (
                    <div className="flex flex-wrap gap-2">
                      {pkg.services.slice(0, 5).map((service, idx) => (
                        <span key={idx} className="px-2 py-1 text-xs bg-gray-100 text-gray-700 rounded-full">
                          {service}
                        </span>
                      ))}
                      {pkg.services.length > 5 && (
                        <span className="px-2 py-1 text-xs text-gray-500">
                          +{pkg.services.length - 5} more
                        </span>
                      )}
                    </div>
                  )}
                </div>
                
                <div className="flex gap-2 ml-4">
                  <Button size="sm" variant="outline">
                    <Edit className="w-4 h-4 mr-1" />
                    Edit
                  </Button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

