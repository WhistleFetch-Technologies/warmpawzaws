'use client';

import React from 'react';
import { X, Calendar, DollarSign } from 'lucide-react';

interface ServiceSubscriptionPreviewProps {
  isOpen: boolean;
  subscription: {
    name: string;
    price: number;
    duration: string;
    features: string[];
  } | null;
  onClose: () => void;
}

export function ServiceSubscriptionPreview({ isOpen, subscription, onClose }: ServiceSubscriptionPreviewProps) {
  if (!isOpen || !subscription) return null;

  return (
    <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
      <div className="bg-white rounded-xl w-full max-w-lg">
        <div className="border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <h3 className="text-lg font-semibold text-gray-900">Subscription Preview</h3>
          <button onClick={onClose} className="p-1 hover:bg-gray-100 rounded-lg">
            <X className="w-5 h-5 text-gray-500" />
          </button>
        </div>

        <div className="p-6 space-y-4">
          <div>
            <h4 className="text-xl font-bold text-gray-900 mb-2">{subscription.name}</h4>
            <div className="flex items-center gap-4 text-gray-600">
              <div className="flex items-center gap-2">
                <DollarSign className="w-4 h-4" />
                <span>₹{subscription.price.toLocaleString()}</span>
              </div>
              <div className="flex items-center gap-2">
                <Calendar className="w-4 h-4" />
                <span>{subscription.duration}</span>
              </div>
            </div>
          </div>

          <div>
            <h5 className="font-semibold text-gray-900 mb-2">Features</h5>
            <ul className="space-y-2">
              {subscription.features.map((feature, index) => (
                <li key={index} className="flex items-center gap-2 text-gray-700">
                  <span className="w-1.5 h-1.5 bg-orange-600 rounded-full"></span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
}

