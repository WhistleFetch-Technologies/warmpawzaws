'use client';

import React, { useState, useEffect } from 'react';
import { apiClient } from '@/lib/api-client';
import { Brain, Search, Loader2, Heart, Activity } from 'lucide-react';

interface PetIntelligence {
  petId: string;
  petName: string;
  ownerName: string;
  breed: string;
  age: number;
  healthScore: number;
  behaviorPatterns: string[];
  recommendations: string[];
}

interface PetIntelligenceSystemProps {
  onBack?: () => void;
}

export function PetIntelligenceSystem({ onBack }: PetIntelligenceSystemProps) {
  const [pets, setPets] = useState<PetIntelligence[]>([]);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState('');

  useEffect(() => {
    loadPets();
  }, []);

  const loadPets = async () => {
    try {
      setLoading(true);
      const response = await apiClient.get<any>('/admin/pets/intelligence');
      if (response.success && response.pets) {
        setPets(response.pets);
      }
    } catch (error) {
      console.error('Error loading pet intelligence:', error);
    } finally {
      setLoading(false);
    }
  };

  const filteredPets = pets.filter(pet =>
    pet.petName.toLowerCase().includes(searchQuery.toLowerCase()) ||
    pet.ownerName.toLowerCase().includes(searchQuery.toLowerCase())
  );

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 w-full max-w-[430px] mx-auto flex items-center justify-center">
        <Loader2 className="w-12 h-12 animate-spin text-orange-600" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 w-full max-w-[430px] mx-auto">
      <div className="bg-white border-b border-gray-200 sticky top-0 z-10">
        <div className="px-4 py-4">
          {onBack && (
            <button
              onClick={onBack}
              className="mb-3 text-gray-600 hover:text-gray-900 flex items-center gap-2"
            >
              ← Back
            </button>
          )}
          <div className="flex items-center gap-3 mb-4">
            <div className="p-2 bg-orange-100 rounded-lg">
              <Brain className="w-6 h-6 text-orange-600" />
            </div>
            <div>
              <h1 className="text-xl font-bold text-gray-900">Pet Intelligence</h1>
              <p className="text-sm text-gray-500">AI-powered pet insights</p>
            </div>
          </div>
          <div className="relative">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" />
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search pets..."
              className="w-full pl-10 pr-4 py-2 border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500"
            />
          </div>
        </div>
      </div>

      <div className="p-4 space-y-3">
        {filteredPets.length === 0 ? (
          <div className="bg-white rounded-lg border-2 border-gray-200 p-8 text-center">
            <Brain className="w-12 h-12 text-gray-400 mx-auto mb-3" />
            <p className="text-gray-500">No pet data found</p>
          </div>
        ) : (
          filteredPets.map((pet) => (
            <div key={pet.petId} className="bg-white rounded-lg border-2 border-gray-200 p-4">
              <div className="flex items-start justify-between mb-3">
                <div className="flex-1">
                  <h3 className="font-semibold text-gray-900 mb-1">{pet.petName}</h3>
                  <p className="text-sm text-gray-600 mb-2">{pet.breed} • {pet.age} years</p>
                  <p className="text-sm text-gray-500">Owner: {pet.ownerName}</p>
                </div>
                <div className="flex items-center gap-2">
                  <div className="text-center">
                    <Heart className="w-5 h-5 text-red-500 mx-auto mb-1" />
                    <span className="text-xs font-semibold text-gray-900">{pet.healthScore}%</span>
                  </div>
                </div>
              </div>
              {pet.behaviorPatterns.length > 0 && (
                <div className="mb-3">
                  <p className="text-xs font-medium text-gray-700 mb-1">Behavior Patterns</p>
                  <div className="flex flex-wrap gap-1">
                    {pet.behaviorPatterns.map((pattern, idx) => (
                      <span key={idx} className="text-xs px-2 py-1 bg-blue-100 text-blue-700 rounded">
                        {pattern}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              {pet.recommendations.length > 0 && (
                <div className="pt-3 border-t border-gray-200">
                  <p className="text-xs font-medium text-gray-700 mb-1">Recommendations</p>
                  <ul className="text-xs text-gray-600 space-y-1">
                    {pet.recommendations.map((rec, idx) => (
                      <li key={idx} className="flex items-start gap-2">
                        <Activity className="w-3 h-3 text-orange-600 mt-0.5 flex-shrink-0" />
                        <span>{rec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))
        )}
      </div>
    </div>
  );
}

