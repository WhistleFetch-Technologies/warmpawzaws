# Admin Web Environment Variables
# Copy this file to .env.local and fill in your values

# API Gateway URL (get from AWS Console or CloudFormation output)
NEXT_PUBLIC_API_GATEWAY_URL=https://z0b3obweb6.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_API_BASE_URL=https://z0b3obweb6.execute-api.ap-south-1.amazonaws.com

# Cognito Configuration (get from AWS Cognito Console)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=ap-south-1

# UAT Mode Credentials
NEXT_PUBLIC_UAT_MODE=true
NEXT_PUBLIC_UAT_ADMIN_EMAIL=admin@warmpawz.com
NEXT_PUBLIC_UAT_ADMIN_PASSWORD=warmpawz2025
