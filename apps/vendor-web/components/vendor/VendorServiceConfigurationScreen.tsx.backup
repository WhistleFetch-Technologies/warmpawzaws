'use client';

import React, { useState, useEffect } from 'react';
import { apiClient } from '@/lib/api-client';
import { Settings, Save, Loader2, DollarSign, Clock } from 'lucide-react';

interface ServiceConfig {
  serviceId: string;
  name: string;
  basePrice: number;
  duration: number;
  description: string;
  isActive: boolean;
}

interface VendorServiceConfigurationScreenProps {
  vendorId: string;
  serviceIds: string[];
  onComplete: () => void;
}

export function VendorServiceConfigurationScreen({ 
  vendorId, 
  serviceIds, 
  onComplete 
}: VendorServiceConfigurationScreenProps) {
  const [configs, setConfigs] = useState<ServiceConfig[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    loadServiceConfigs();
  }, [serviceIds]);

  const loadServiceConfigs = async () => {
    try {
      setLoading(true);
      const response = await apiClient.get<any>(`/vendor/services/config?serviceIds=${serviceIds.join(',')}`);
      if (response.success && response.services) {
        setConfigs(response.services);
      }
    } catch (error) {
      console.error('Error loading service configs:', error);
    } finally {
      setLoading(false);
    }
  };

  const updateConfig = (serviceId: string, field: keyof ServiceConfig, value: any) => {
    setConfigs(prev =>
      prev.map(config =>
        config.serviceId === serviceId ? { ...config, [field]: value } : config
      )
    );
  };

  const handleSubmit = async () => {
    try {
      setSaving(true);
      const response = await apiClient.post<any>('/vendor/services/configure', {
        vendorId,
        configurations: configs,
      });

      if (response.success) {
        onComplete();
      } else {
        alert('Failed to save configurations');
      }
    } catch (error) {
      console.error('Error saving configurations:', error);
      alert('Error saving configurations');
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gray-50 w-full max-w-[430px] mx-auto flex items-center justify-center">
        <Loader2 className="w-12 h-12 animate-spin text-orange-600" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 w-full max-w-[430px] mx-auto p-4">
      <div className="bg-white rounded-lg border-2 border-gray-200 p-6">
        <div className="flex items-center gap-3 mb-6">
          <Settings className="w-6 h-6 text-orange-600" />
          <h1 className="text-xl font-bold text-gray-900">Configure Your Services</h1>
        </div>

        <p className="text-sm text-gray-600 mb-6">
          Set pricing and duration for each service. You can update these anytime from your dashboard.
        </p>

        <div className="space-y-4 mb-6">
          {configs.map((config) => (
            <div key={config.serviceId} className="border-2 border-gray-200 rounded-lg p-4">
              <div className="flex items-center justify-between mb-4">
                <h3 className="font-semibold text-gray-900">{config.name}</h3>
                <label className="flex items-center gap-2">
                  <input
                    type="checkbox"
                    checked={config.isActive}
                    onChange={(e) => updateConfig(config.serviceId, 'isActive', e.target.checked)}
                    className="w-4 h-4 text-orange-600 rounded"
                  />
                  <span className="text-sm text-gray-600">Active</span>
                </label>
              </div>

              <div className="space-y-3">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1 flex items-center gap-2">
                    <DollarSign className="w-4 h-4 text-gray-400" />
                    Base Price (₹)
                  </label>
                  <input
                    type="number"
                    value={config.basePrice}
                    onChange={(e) => updateConfig(config.serviceId, 'basePrice', parseFloat(e.target.value) || 0)}
                    className="w-full px-3 py-2 border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500"
                    min="0"
                    step="0.01"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1 flex items-center gap-2">
                    <Clock className="w-4 h-4 text-gray-400" />
                    Duration (minutes)
                  </label>
                  <input
                    type="number"
                    value={config.duration}
                    onChange={(e) => updateConfig(config.serviceId, 'duration', parseInt(e.target.value) || 0)}
                    className="w-full px-3 py-2 border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500"
                    min="1"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">
                    Description
                  </label>
                  <textarea
                    value={config.description}
                    onChange={(e) => updateConfig(config.serviceId, 'description', e.target.value)}
                    className="w-full px-3 py-2 border-2 border-gray-200 rounded-lg focus:ring-2 focus:ring-orange-500"
                    rows={2}
                    placeholder="Service description..."
                  />
                </div>
              </div>
            </div>
          ))}
        </div>

        <button
          onClick={handleSubmit}
          disabled={saving}
          className="w-full py-3 bg-orange-600 text-white rounded-lg hover:bg-orange-700 font-medium flex items-center justify-center gap-2 disabled:opacity-50"
        >
          {saving ? (
            <>
              <Loader2 className="w-5 h-5 animate-spin" />
              Saving...
            </>
          ) : (
            <>
              <Save className="w-5 h-5" />
              Save Configuration
            </>
          )}
        </button>
      </div>
    </div>
  );
}

