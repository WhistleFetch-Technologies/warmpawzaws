# CodeBuild for delivery-service Docker image (Maven runs inside the Dockerfile).
# Copy to delivery-codebuild.auto.tfvars in this directory (gitignored as *.tfvars)
# or merge into your existing terraform.tfvars.
#
# Requires: enable_delivery_stack = true and non-empty delivery_service_image (ECR URI),
# same as the ECS module.
#
# Git branch: set `delivery_codebuild_branch_ref` (e.g. refs/heads/dev-bindushree-java).
# That commit on GitHub must include `services/delivery-service/buildspec.yml` and the Dockerfile.

delivery_codebuild_github_url = "https://github.com/WhistleFetch-Technologies/warmpawzaws.git"
delivery_codebuild_branch_ref = "refs/heads/dev-bindushree-java"

# Public GitHub repos: leave false so CodeBuild clones without CodeStar (avoids broken CreateProject + connection IAM in some accounts).
# Private repos: set true, set delivery_codebuild_codestar_connection_arn or let Terraform create a connection and finish OAuth.
# delivery_codebuild_use_github_codeconnection = false

# Uncomment to override branch:
# delivery_codebuild_branch_ref = "refs/heads/main"
# delivery_codebuild_codestar_connection_arn = "arn:aws:codestar-connections:..."
